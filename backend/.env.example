# ====================================================================
# CardioSense Environment Variables Template for Deployment
# ====================================================================
# DO NOT COMMIT ACTUAL SECRET KEYS TO SOURCE CONTROL.
# Configure these variables in your hosting provider's dashboard (e.g. Vercel).

# --------------------------------------------------
# Supabase Configuration
# --------------------------------------------------
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# Secret service role key for private Storage model download (cardiosense-model bucket)
# Keep this strictly in backend server environment variables; NEVER expose to client.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Storage bucket where cardiosense_resnet18.pth is stored (defaults to cardiosense-model)
SUPABASE_MODEL_BUCKET="cardiosense-model"

# --------------------------------------------------
# AI / LLM Configuration
# --------------------------------------------------
GEMINI_API_KEY="your-gemini-api-key"

# --------------------------------------------------
# Clerk Authentication Configuration
# --------------------------------------------------
# The Clerk JWT Issuer URL (e.g. https://clerk.yourdomain.com or https://verb-noun-00.clerk.accounts.dev)
# Used by backend/auth.py to verify JWT signature via JWKS
CLERK_ISSUER="https://your-app.clerk.accounts.dev"

# --------------------------------------------------
# CORS Configuration
# --------------------------------------------------
# Comma-separated list of allowed origins (e.g. your production frontend URL)
CORS_ORIGINS="http://localhost:3000,https://your-frontend.vercel.app"
